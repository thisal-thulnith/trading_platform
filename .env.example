# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-strong-password
AIT_JWT_SECRET=generate-with-openssl-rand-hex-32
PUBLIC_API_URL=http://localhost:8100
PUBLIC_WEB_URL=http://localhost:3100

# Optional
AIT_ANTHROPIC_API_KEY=
# Or use OpenAI instead (server-side only; never put keys in the frontend)
AIT_OPENAI_API_KEY=
AIT_OPENAI_MODEL=gpt-5.5
# auto = Anthropic if its key is set, else OpenAI
AIT_LLM_PROVIDER=auto
AIT_LLM_MODEL=claude-opus-5-5
AIT_LLM_EFFORT=medium
AIT_COINGECKO_API_KEY=
AIT_TELEGRAM_BOT_TOKEN=
AIT_TELEGRAM_CHAT_ID=
# smtp://user:pass@host:587/recipient@example.com
AIT_SMTP_URL=
